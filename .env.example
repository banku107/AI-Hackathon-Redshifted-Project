# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or share keys in a public chat.

ANTHROPIC_API_KEY=          # everyone (shared team key)
DETECTOR_API_USER=          # free Sightengine account > API keys > "API user"
DETECTOR_API_KEY=           # free Sightengine account > API keys > "API secret"
TWILIO_ACCOUNT_SID=         # Person 2 (optional, for real texts)
TWILIO_AUTH_TOKEN=          # Person 2 (optional)
TWILIO_FROM_NUMBER=         # Person 2 (optional)
RESEND_API_KEY=             # Person 2 (optional, for emails)
SAFE_BROWSING_API_KEY=      # Person 2 (optional)
DEMO_MODE=false             # true = replay recorded demo runs, no API calls
AGENT_EFFORT=high           # low | medium | high (lower = faster, less careful)
